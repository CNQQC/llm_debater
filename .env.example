# 复制本文件为 .env，并填入你拥有的提供商的 API Key。
# 没有的留空即可——系统会自动跳过对应的辩手。

# DeepSeek    https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Kimi / Moonshot   https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# SiliconFlow 硅基流动   https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# OpenRouter   https://openrouter.ai/
OPENROUTER_API_KEY=
